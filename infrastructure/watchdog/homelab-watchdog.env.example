# =============================================================================
# homelab-watchdog.env — configuração dos watchdogs
#
# Instalar em /etc/homelab-watchdog.env na VM (root:root, 0600).
# NUNCA commitar a versão preenchida: as push URLs são tokens de acesso ao
# Uptime Kuma. Este .example é o único que vai para o repositório.
#
# As push URLs vêm de monitores do tipo "Push" criados no Uptime Kuma:
#   Uptime Kuma → Add New Monitor → Monitor Type: Push → copiar o token
# Os watchdogs rodam no HOST, que não resolve nomes de container (o DNS do Docker
# só existe dentro da rede). Por isso a URL usa o IP fixo do uptime-kuma
# (172.18.0.4, reservado fora do pool dinâmico) e não o domínio público — que
# além disso sofreria com o hairpin NAT do Docker (ADR-008).
# =============================================================================

# ─── Watchdog de DNS ─────────────────────────────────────────────────────────
DNS_PUSH_URL=http://172.18.0.4:3001/api/push/{{DNS_PUSH_TOKEN}}
ADGUARD_IP=172.18.0.2
DNS_PROBE_DOMAIN=cloudflare.com
DNS_STACK_DIR=/srv/the-forge/services/dns
DNS_FAIL_THRESHOLD=2

# ─── Watchdog do túnel Mullvad ───────────────────────────────────────────────
VPN_PUSH_URL=http://172.18.0.4:3001/api/push/{{VPN_PUSH_TOKEN}}
WG_IF=wg-mull-br
WG_TABLE=51820
TS_SUBNET=100.64.0.0/10
WG_HANDSHAKE_MAX_AGE=300
WG_FAIL_THRESHOLD=2
