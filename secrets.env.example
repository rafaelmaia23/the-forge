# =============================================================================
# secrets.env — Variáveis específicas desta instalação
#
# Copie este arquivo para secrets.env e preencha com os valores reais:
#   cp secrets.env.example secrets.env
#
# O secrets.env está no .gitignore (coberto por *.env) e nunca deve ser
# commitado. Este arquivo é o único que vai para o repositório.
#
# Nos scripts: source secrets.env
# Nas docs:    os placeholders {{NOME}} correspondem às variáveis aqui.
# =============================================================================

# ─── Oracle Cloud Infrastructure ─────────────────────────────────────────────
OCI_PUBLIC_IP=        # IP público da VM (ex: 152.xx.xx.xx)
OCI_TS_IP=            # IP Tailscale da VM (ex: 100.xx.xx.xx)
OCI_REGION=           # Região OCI (ex: sa-saopaulo-1)
OCI_AD=               # Availability Domain (ex: GrCH:SA-SAOPAULO-1-AD-1)

# ─── Rede pessoal ─────────────────────────────────────────────────────────────
MEU_IP=               # IP da sua conexão local (usado em regras SSH temporárias)

# ─── Cloudflare ───────────────────────────────────────────────────────────────
CF_API_TOKEN=         # Token da API Cloudflare (DNS Challenge para certificados)
CF_ZONE_ID=           # Zone ID do domínio no Cloudflare

# ─── Domínio ──────────────────────────────────────────────────────────────────
DOMINIO=maiahub.com.br

# ─── Nginx Proxy Manager ──────────────────────────────────────────────────────
NPM_ADMIN_PASSWORD=    # Senha do admin do NPM (gerada com openssl rand -base64 24)

# ─── Portainer ────────────────────────────────────────────────────────────────
PORTAINER_ADMIN_PASSWORD=  # Senha do admin do Portainer (gerada com openssl rand -base64 24)

# ─── Uptime Kuma ──────────────────────────────────────────────────────────────
UPTIME_KUMA_ADMIN_PASSWORD=  # Senha do admin do Uptime Kuma (gerada com openssl rand -base64 24)

# ─── Telegram (alertas — Netdata e Uptime Kuma) ───────────────────────────────
NETDATA_TELEGRAM_BOT_TOKEN=  # Token do bot Telegram para alertas do Netdata (BotFather)
TELEGRAM_CHAT_ID=            # Chat ID do destinatário dos alertas (api.telegram.org/bot<TOKEN>/getUpdates)
